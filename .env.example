# ==============================================================================
# HomeStream Configuration Template
# https://github.com/Eckobrew/HomeStream
# ==============================================================================

# Application Branding
APP_NAME=HomeStream
PORT=3000

# ------------------------------------------------------------------------------
# Persistent Storage & Mounts
# ------------------------------------------------------------------------------
# Local path on host mapped into container services
DATA_PATH=./data
DOWNLOADS_PATH=/mnt/downloads
MUSIC_PATH=/mnt/music
YOUTUBE_PATH=/mnt/youtube

# ------------------------------------------------------------------------------
# Jellyfin Media Server Settings
# ------------------------------------------------------------------------------
# Direct LAN or reverse-proxy URL to your Jellyfin server (no trailing slash)
# Example: http://192.168.1.50:8096 or https://jellyfin.example.com
JELLYFIN_URL=http://192.168.1.50:8096

# Jellyfin API Key (Dashboard -> Advanced -> API Keys -> Create Key named "HomeStream")
JELLYFIN_API_KEY=your_jellyfin_api_key_here

# (Optional) Specific Jellyfin User ID (blank uses primary user on the server)
JELLYFIN_USER_ID=

# ------------------------------------------------------------------------------
# TheMovieDatabase (TMDB) & Seerr (Jellyseerr / Overseerr)
# ------------------------------------------------------------------------------
# TMDB API Key v3 (for high-resolution backdrops, logos, and release discovery)
# Obtain free from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# URL to your Jellyseerr or Overseerr instance (no trailing slash)
# Example: http://192.168.1.50:5055
SEERR_URL=http://192.168.1.50:5055

# Seerr API Key (Jellyseerr / Overseerr -> Settings -> General -> API Key)
SEERR_API_KEY=your_seerr_api_key_here

# ------------------------------------------------------------------------------
# Arr Automation Stack (Sonarr & Radarr)
# ------------------------------------------------------------------------------
# Sonarr (TV Shows)
SONARR_URL=http://192.168.1.50:8989
SONARR_API_KEY=your_sonarr_api_key_here

# Radarr (Movies)
RADARR_URL=http://192.168.1.50:7878
RADARR_API_KEY=your_radarr_api_key_here

# ------------------------------------------------------------------------------
# Soulseek / Music Hub Integration (slskd)
# ------------------------------------------------------------------------------
# slskd URL & API Key (for peer-to-peer album discovery and automated downloads)
SLSKD_URL=http://192.168.1.50:5030
SLSKD_API_KEY=your_slskd_api_key_here

# ------------------------------------------------------------------------------
# Torrent Client (qBittorrent) - For In-Progress Sequential Streaming
# ------------------------------------------------------------------------------
# URL to qBittorrent WebUI (no trailing slash)
# Example: http://192.168.1.50:8080 or http://qbittorrent:8080
QBITTORRENT_URL=http://localhost:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=your_qbittorrent_password_here

# ------------------------------------------------------------------------------
# Security, Android Pairing & Networking
# ------------------------------------------------------------------------------
# Public URL where HomeStream is reachable outside your home network
# Example: https://homestream.yourdomain.com
HOMESTREAM_EXTERNAL_URL=

# Mobile pairing token (minimum 32 characters; generate with `openssl rand -hex 32`)
HOMESTREAM_MOBILE_TOKEN=

# Session signing secret (minimum 32 characters; generate with `openssl rand -hex 32`)
HOMESTREAM_SESSION_SECRET=

# Bootstrap token for API configuration (minimum 32 characters)
HOMESTREAM_SETUP_TOKEN=

# Webhook token accepted by /api/webhook/arr
HOMESTREAM_WEBHOOK_TOKEN=

# Trust upstream reverse proxy headers (set to true behind Nginx / Traefik / Cloudflare)
HOMESTREAM_TRUST_PROXY=true

# Exact IP addresses of trusted upstream reverse proxies
# Example: 192.168.1.187,192.168.1.214
HOMESTREAM_TRUSTED_PROXIES=

# ------------------------------------------------------------------------------
# Transcoding & Performance
# ------------------------------------------------------------------------------
# Maximum simultaneous live ffmpeg transcoding streams
HOMESTREAM_MAX_CONVERSIONS=2

# Transcode process inactivity timeout in milliseconds (default: 300000 = 5 min)
HOMESTREAM_CONVERSION_TIMEOUT_MS=300000
